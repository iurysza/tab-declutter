{
  "name": "tab-declutter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src manifest.config.ts vite.config.ts --deny-warnings",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run verify:project",
    "verify:project": "bun run scripts/verify-project.ts",
    "mock:provider": "bun run scripts/mock-provider.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/google": "^4.0.104",
    "@ai-sdk/openai": "^4.0.101",
    "@ai-sdk/openai-compatible": "^3.0.77",
    "ai": "^7.0.150",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
